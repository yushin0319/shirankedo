{
  "name": "shirankedo",
  "compatibility_date": "2026-03-14",
  "compatibility_flags": ["nodejs_compat"],
  // Astro v6 の build 出力に scheduled handler を併載するための custom entrypoint
  "main": "src/worker.ts",
  // Cron Triggers（最大3本、 5分刻みで深夜 00:00-00:10 JST 帯に集約）:
  //   UTC 15:00 = JST 00:00: articles
  //   UTC 15:05 = JST 00:05: stars
  //   UTC 15:10 = JST 00:10: repos
  // 各 WF は DAILY_XXX_ENABLED="true" で実走、未設定は dry-run。
  "triggers": {
    "crons": ["0 15 * * *", "5 15 * * *", "10 15 * * *"]
  },
  // Cloudflare Dashboard でログ検索（無料枠で約7日保持）
  "observability": {
    "enabled": true
  },
  // M11: level=error / exception を observability-tail Worker に流して Discord 通知
  "tail_consumers": [
    {
      "service": "observability-tail"
    }
  ],
  "vars": {
    "DAILY_ARTICLES_ENABLED": "true",
    "DAILY_REPOS_ENABLED": "true"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shirankedo",
      "database_id": "bb2f61cf-ede8-4d66-97bb-01b39d52550d",
      "migrations_dir": "drizzle"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "e0cfe70075d74f31b080b1653617acff"
    }
  ]
}
