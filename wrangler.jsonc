{
  "name": "shirankedo",
  "compatibility_date": "2026-03-14",
  "compatibility_flags": ["nodejs_compat"],
  // Astro v6 の build 出力に scheduled handler を併載するための custom entrypoint
  "main": "src/worker.ts",
  // Cron Triggers（最大3本）:
  //   [一時テスト] UTC 13:50 = JST 22:50: articles + vulns + security（並列、release は REPOS 側へ移動）
  //   [一時テスト] UTC 13:55 = JST 22:55: stars
  //   [一時テスト] UTC 14:00 = JST 23:00: repos + release（2 並列）
  // PR #137 の cron 修正 (self-fetch → 直接 D1) を本番動作確認するため一時的に
  // 平日昼間に発火させる。確認後に元の深夜 schedule に戻す revert PR を出す。
  // 各 WF は DAILY_XXX_ENABLED="true" で実走、未設定は dry-run。
  "triggers": {
    "crons": ["50 13 * * *", "55 13 * * *", "55 15 * * *"]
  },
  // Cloudflare Dashboard でログ検索（無料枠で約7日保持）
  "observability": {
    "enabled": true
  },
  // M11: level=error / exception を observability-tail Worker に流して Discord 通知
  "tail_consumers": [
    {
      "service": "observability-tail"
    }
  ],
  "vars": {
    "DAILY_ARTICLES_ENABLED": "true",
    "DAILY_VULNS_ENABLED": "true",
    "DAILY_RELEASES_ENABLED": "true",
    "DAILY_SECURITY_ENABLED": "true",
    "DAILY_REPOS_ENABLED": "true"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shirankedo",
      "database_id": "bb2f61cf-ede8-4d66-97bb-01b39d52550d",
      "migrations_dir": "drizzle"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "e0cfe70075d74f31b080b1653617acff"
    }
  ]
}
