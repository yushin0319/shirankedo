---
interface Props {
	title: string;
	currentPage?: string;
}

const { title, currentPage = "news" } = Astro.props;

const navItems = [
	{ id: "news", label: "ニュース", href: "/" },
	{ id: "security", label: "セキュリティ", href: "/security" },
	{ id: "trend", label: "トレンド", href: "/trend" },
	{ id: "ai", label: "AI比較", href: "/ai" },
];
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title} | ShiranKedo</title>
		<meta name="description" content="テック界隈で今日起きたことを3分で把握するニュースダッシュボード" />
		<meta property="og:title" content={`${title} | ShiranKedo`} />
		<meta property="og:description" content="テック界隈で今日起きたことを3分で把握するニュースダッシュボード" />
		<meta property="og:type" content="website" />
		<meta property="og:url" content="https://shirankedo.y-fudo.workers.dev/" />
		<meta property="og:image" content="https://shirankedo.y-fudo.workers.dev/og-image.svg" />
		<meta name="twitter:card" content="summary" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.svg" />
		<link rel="manifest" href="/manifest.json" />
		<meta name="theme-color" content="#f5f3ee" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;700&family=DM+Mono:wght@400;500&family=Noto+Sans+JP:wght@400;500;700&display=swap&subset=latin,japanese"
			rel="stylesheet"
		/>
	</head>
	<body>
		<header
			class="sticky top-0 z-100 bg-surface border-b border-border shadow-[0_2px_8px_rgba(0,0,0,.05)]"
		>
			<div
				class="max-w-[1060px] mx-auto px-10 h-14 flex items-center justify-between max-md:px-4"
			>
				<a href="/" class="font-display text-[22px] font-bold text-ink tracking-tight no-underline">
					Shiran<span class="text-accent">Kedo</span>
				</a>
				<nav class="flex max-md:hidden">
					{
						navItems.map((item) => (
							<a
								href={item.href}
								class:list={[
									"font-mono text-[10px] tracking-[.06em] px-3 py-1.5 no-underline transition-colors",
									currentPage === item.id
										? "text-ink font-medium"
										: "text-muted hover:text-ink",
								]}
							>
								{item.label}
							</a>
						))
					}
				<a
						href="/about"
						class:list={[
							"font-mono text-[10px] tracking-[.06em] px-2 py-1.5 no-underline transition-colors max-md:hidden",
							currentPage === "about"
								? "text-ink font-medium"
								: "text-muted hover:text-ink",
						]}
					>About</a>
				</nav>
				<button
					class="hidden max-md:flex flex-col gap-[5px] p-1 bg-transparent border-none cursor-pointer"
					id="hamburger"
					aria-label="メニューを開く"
					aria-expanded="false"
					aria-controls="mobile-nav"
				>
					<span class="block w-5 h-[1.5px] bg-muted"></span>
					<span class="block w-5 h-[1.5px] bg-muted"></span>
					<span class="block w-5 h-[1.5px] bg-muted"></span>
				</button>
			</div>
		</header>

		<div
			class="hidden fixed top-14 left-0 right-0 bg-surface border-b border-border px-5 py-3 flex-col z-99"
			id="mobile-nav"
			aria-hidden="true"
		>
			{
				navItems.map((item) => (
					<a
						href={item.href}
						class:list={[
							"font-mono text-xs tracking-[.06em] py-2.5 no-underline border-b border-border",
							currentPage === item.id ? "text-ink" : "text-muted",
						]}
					>
						{item.label}
					</a>
				))
			}
			<a
				href="/about"
				class:list={[
					"font-mono text-xs tracking-[.06em] py-2.5 no-underline",
					currentPage === "about" ? "text-ink" : "text-muted",
				]}
			>
				About
			</a>
		</div>

		<slot />

		<script>
			const hamburger = document.getElementById("hamburger");
			const mobileNav = document.getElementById("mobile-nav");
			hamburger?.addEventListener("click", () => {
				const isOpen = mobileNav?.classList.contains("flex");
				mobileNav?.classList.toggle("hidden");
				mobileNav?.classList.toggle("flex");
				hamburger.setAttribute("aria-expanded", String(!isOpen));
				mobileNav?.setAttribute("aria-hidden", String(isOpen));
			});

			// セクション間フリック切り替え
			const SECTIONS = ["/", "/security", "/trend", "/ai"];
			const SWIPE_THRESHOLD = 50;
			let touchStart: { x: number; y: number } | null = null;

			document.addEventListener("touchstart", (e) => {
				const touch = e.touches[0];
				touchStart = { x: touch.clientX, y: touch.clientY };
			});

			document.addEventListener("touchend", (e) => {
				if (!touchStart) return;
				const touch = e.changedTouches[0];
				const dx = touch.clientX - touchStart.x;
				const dy = touch.clientY - touchStart.y;
				touchStart = null;

				if (Math.abs(dy) > Math.abs(dx)) return;
				if (Math.abs(dx) < SWIPE_THRESHOLD) return;

				const target = e.target as HTMLElement;
				if (target.tagName === "INPUT" || target.tagName === "TEXTAREA") return;

				const idx = SECTIONS.indexOf(window.location.pathname);
				if (idx === -1) return;

				let nextIdx = -1;
				if (dx < 0 && idx < SECTIONS.length - 1) nextIdx = idx + 1;
				else if (dx > 0 && idx > 0) nextIdx = idx - 1;
				if (nextIdx === -1) return;

				const nextUrl = SECTIONS[nextIdx];
				const direction = nextIdx > idx ? "left" : "right";

				// クロスドキュメント View Transitions 用にセッションストレージで方向を渡す
				sessionStorage.setItem("swipe-direction", direction);
				window.location.href = nextUrl;
			});

			// ページ表示時: セッションストレージから方向を取得してアニメーション適用
			const dir = sessionStorage.getItem("swipe-direction");
			if (dir) {
				sessionStorage.removeItem("swipe-direction");
				document.documentElement.dataset.swipeDirection = dir;
				requestAnimationFrame(() => {
					document.documentElement.classList.add("swipe-animate");
					document.documentElement.addEventListener("animationend", () => {
						document.documentElement.classList.remove("swipe-animate");
						delete document.documentElement.dataset.swipeDirection;
					}, { once: true });
				});
			}
		</script>
	</body>
</html>

<style is:global>
	@import "../styles/global.css";

	/* セクション間フリック: スライドインアニメーション */
	html.swipe-animate[data-swipe-direction="left"] body {
		animation: slide-in-right 250ms ease-out;
	}
	html.swipe-animate[data-swipe-direction="right"] body {
		animation: slide-in-left 250ms ease-out;
	}

	@keyframes slide-in-right {
		from { opacity: 0; transform: translateX(80px); }
		to { opacity: 1; transform: translateX(0); }
	}
	@keyframes slide-in-left {
		from { opacity: 0; transform: translateX(-80px); }
		to { opacity: 1; transform: translateX(0); }
	}

	@media (prefers-reduced-motion: reduce) {
		html.swipe-animate body {
			animation: none;
		}
	}
</style>
