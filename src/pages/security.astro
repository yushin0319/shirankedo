---
import { env } from "cloudflare:workers";
import { desc } from "drizzle-orm";
import Layout from "../layouts/Layout.astro";
import { getDb } from "../db/client";
import { vulnerabilities, releases, securityDaily } from "../db/schema";

const db = getDb(env.DB);

const daily = await db
	.select()
	.from(securityDaily)
	.orderBy(desc(securityDaily.createdAt))
	.limit(1);

const vulns = await db
	.select()
	.from(vulnerabilities)
	.orderBy(desc(vulnerabilities.cvssScore))
	.limit(10);

const rels = await db
	.select()
	.from(releases)
	.orderBy(desc(releases.publishedAt))
	.limit(10);

const dailyComment = daily[0]?.comment ?? null;
---

<Layout title="セキュリティ" currentPage="security">
	<div class="relative z-1 max-w-[1060px] mx-auto px-10 pt-7 pb-5 max-md:px-4 max-md:pt-5 max-md:pb-4">
		<h1 class="font-mono text-[11px] text-muted tracking-[.06em] uppercase">Security Overview</h1>
	</div>
	<main class="relative z-1 max-w-[1060px] mx-auto px-10 pb-20 max-md:px-4 max-md:pb-15">
		{dailyComment && (
			<div class="relative max-w-[400px] mb-8 p-4 pb-5.5 bg-sticky-5 rotate-[-0.6deg] shadow-[3px_5px_12px_rgba(0,0,0,.18),0_1px_3px_rgba(0,0,0,.08)]">
				<p class="text-xs leading-[1.8] text-sticky-ink">{dailyComment}</p>
				<div class="sticky-fold"></div>
			</div>
		)}

		<section class="mb-12">
			<h2 class="font-mono text-[10px] text-muted tracking-[.1em] uppercase mb-4">Vulnerabilities</h2>
			<div class="flex flex-col gap-3">
				{vulns.map((v) => (
					<div class="bg-surface border border-border rounded-sm shadow-[2px_2px_0_rgba(0,0,0,.06)] flex overflow-hidden">
						<div class="w-1 bg-accent shrink-0"></div>
						<div class="p-4 flex-1">
							<div class="flex items-center gap-3 mb-1.5 flex-wrap">
								<span class="font-mono text-[10px] text-accent tracking-[.04em]">{v.cveId}</span>
								{v.cvssScore && (
									<span class="font-mono text-[10px] text-white bg-accent px-1.5 py-0.5 rounded-sm font-medium">
										CVSS {v.cvssScore.toFixed(1)}
									</span>
								)}
								<span class="font-mono text-[10px] text-muted tracking-[.04em] ml-auto">{v.publishedAt}</span>
							</div>
							<p class="text-[14px] font-bold leading-[1.55] text-ink">{v.title}</p>
						</div>
					</div>
				))}
				{vulns.length === 0 && (
					<p class="text-center text-muted py-10 font-mono text-sm">脆弱性情報なし</p>
				)}
			</div>
		</section>

		<section>
			<h2 class="font-mono text-[10px] text-muted tracking-[.1em] uppercase mb-4">Recent Releases</h2>
			<div class="flex flex-col gap-3">
				{rels.map((r) => {
					const isMajor = r.type === "major";
					return (
						<div class="bg-surface border border-border rounded-sm shadow-[2px_2px_0_rgba(0,0,0,.06)] flex overflow-hidden">
							<div class:list={["w-1 shrink-0", isMajor ? "bg-tag-frontend-text" : "bg-tag-oss-text"]}></div>
							<div class="p-4 flex-1 flex items-center justify-between gap-4 flex-wrap">
								<div>
									<span class="text-[14px] font-bold text-ink">{r.repo}</span>
									<span class="font-mono text-[10px] text-muted ml-2">{r.publishedAt}</span>
								</div>
								<div class="flex items-center gap-2">
									<span class:list={[
										"font-mono text-[9px] tracking-[.08em] px-2 py-0.5 rounded-sm font-medium",
										isMajor ? "bg-tag-frontend-bg text-tag-frontend-text" : "bg-tag-oss-bg text-tag-oss-text"
									]}>
										{r.type.toUpperCase()}
									</span>
									<span class="font-mono text-[11px] text-ink font-medium">{r.tag}</span>
								</div>
							</div>
						</div>
					);
				})}
				{rels.length === 0 && (
					<p class="text-center text-muted py-10 font-mono text-sm">リリース情報なし</p>
				)}
			</div>
		</section>
	</main>
</Layout>

<style>
	.sticky-fold {
		position: absolute;
		bottom: 0;
		right: 0;
		width: 0;
		height: 0;
		border-style: solid;
		border-width: 0 0 20px 20px;
		border-color: transparent transparent rgba(0, 0, 0, 0.18) transparent;
	}
</style>
