---
import { env } from "cloudflare:workers";
import { desc } from "drizzle-orm";
import Layout from "../layouts/Layout.astro";
import { getDb } from "../db/client";
import { vulnerabilities, releases, securityDaily, trackingRepos, repoStats } from "../db/schema";
import { SecurityTabs } from "../components/SecurityTabs";
import { ErrorBoundary } from "../components/ErrorFallback";
import { formatDisplayDate } from "../lib/date";
import { vulnDecayScore, releaseDecayScore } from "../lib/score";
import { sql } from "drizzle-orm";

let vulns: any[] = [];
let rels: any[] = [];
let dailyComment: string | null = null;
let repoMap: Record<string, { displayName: string; description: string | null }> = {};
let fetchError = false;

try {
	const db = getDb(env.DB);

	const daily = await db
		.select()
		.from(securityDaily)
		.orderBy(desc(securityDaily.createdAt))
		.limit(1);

	const vulnsRaw = await db.select().from(vulnerabilities);
	const relsRaw = await db.select().from(releases);

	const latestStats = await db
		.select({ repo: repoStats.repo, stars: repoStats.stars })
		.from(repoStats)
		.where(sql`${repoStats.id} IN (SELECT MAX(id) FROM repo_stats GROUP BY repo)`);
	const starsMap: Record<string, number> = Object.fromEntries(
		latestStats.map((s) => [s.repo, s.stars]),
	);

	const now = new Date();
	vulns = vulnsRaw.sort(
		(a, b) => vulnDecayScore(b.cvssScore, b.publishedAt, now) - vulnDecayScore(a.cvssScore, a.publishedAt, now),
	);
	rels = relsRaw.sort(
		(a, b) => releaseDecayScore(starsMap[b.repo] ?? 0, b.type, b.publishedAt, now) - releaseDecayScore(starsMap[a.repo] ?? 0, a.type, a.publishedAt, now),
	);

	dailyComment = daily[0]?.comment ?? null;

	const repos = await db.select().from(trackingRepos);
	repoMap = Object.fromEntries(
		repos.map((r) => [r.repo, { displayName: r.displayName, description: r.description ?? null }])
	);
} catch {
	fetchError = true;
}

const today = new Date().toISOString().slice(0, 10);
const displayDate = formatDisplayDate(today);
---

<Layout title="セキュリティ" currentPage="security">
	<div
		class="relative z-1 max-w-265 mx-auto px-10 pt-7 pb-0 flex items-baseline justify-between max-md:px-4 max-md:pt-5"
	>
		<div class="font-mono text-[11px] text-muted tracking-[.06em]">
			{displayDate}
		</div>
	</div>
	{fetchError ? (
		<main class="relative z-1 max-w-265 mx-auto px-10 pb-20 max-md:px-4">
			<p class="text-center text-muted py-20 font-mono text-sm">
				データの取得に失敗しました。しばらく待ってから再読み込みしてね
			</p>
		</main>
	) : (
		<ErrorBoundary client:idle>
			<SecurityTabs
				vulns={vulns}
				rels={rels}
				repoMap={repoMap}
				dailyComment={dailyComment}
			/>
		</ErrorBoundary>
	)}
</Layout>

<style is:global>
	@import "../styles/security.css";
</style>
