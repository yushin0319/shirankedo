---
import { env } from "cloudflare:workers";
import { desc, sql } from "drizzle-orm";
import Layout from "../layouts/Layout.astro";
import { getDb } from "../db/client";
import { llmModels, subscriptionPlans, pageComments } from "../db/schema";
import { parseModels, estimateMonthly } from "../lib/ai";

const db = getDb(env.DB);

const models = await db
	.select()
	.from(llmModels)
	.orderBy(desc(llmModels.score));

const plans = await db
	.select()
	.from(subscriptionPlans)
	.orderBy(subscriptionPlans.provider, subscriptionPlans.price);

// AI比較コメント（ページ全体で1つ）
const aiComment = await db
	.select()
	.from(pageComments)
	.where(sql`${pageComments.type} = 'ai_api'`)
	.orderBy(desc(pageComments.createdAt))
	.limit(1);

const commentText = aiComment[0]?.content ?? null;

// プロバイダーのドット色（20色）
const providerDotClass: Record<string, string> = {
	OpenAI: "dot-openai",
	Anthropic: "dot-anthropic",
	Google: "dot-google",
	DeepSeek: "dot-deepseek",
	xAI: "dot-xai",
	Meta: "dot-meta",
	Mistral: "dot-mistral",
	BFL: "dot-bfl",
	Midjourney: "dot-midjourney",
	Ideogram: "dot-ideogram",
	Stability: "dot-stability",
	Perplexity: "dot-perplexity",
	Recraft: "dot-recraft",
	Alibaba: "dot-alibaba",
	Moonshot: "dot-moonshot",
	MiniMax: "dot-minimax",
	"Zhipu AI": "dot-zhipu",
	Xiaomi: "dot-xiaomi",
	Amazon: "dot-amazon",
	Microsoft: "dot-microsoft",
};

// ベンチマークバーのティア
function getTier(score: number): string {
	if (score >= 50) return "tier-s";
	if (score >= 40) return "tier-a";
	if (score >= 30) return "tier-b";
	return "tier-c";
}

const today = new Date().toISOString().slice(0, 10);
---

<Layout title="AI比較" currentPage="ai">
	<div
		class="relative z-1 max-w-[1060px] mx-auto px-10 pt-6 pb-0 max-md:px-4 max-md:pt-4"
	>
		<div class="font-mono text-[11px] text-muted tracking-[.06em]">
			Weekly Compare&nbsp;&middot;&nbsp;{today}
		</div>
	</div>
	<main class="relative z-1 max-w-[1060px] mx-auto px-10 pb-20 max-md:px-4 max-md:pb-15">
		{/* section-heading */}
		<div class="mt-7 mb-4.5">
			<h2 class="text-[17px] font-bold tracking-[-0.01em]">AI比較</h2>
			<div class="h-px bg-border my-2"></div>
			<span class="font-mono text-[10px] text-muted tracking-[.06em]">
				API pricing&nbsp;&middot;&nbsp;benchmarks&nbsp;&middot;&nbsp;subscriptions
			</span>
		</div>

		{/* タブバー */}
		<div class="flex gap-0 border-b border-border mb-0">
			<button
				class="ai-tab-btn text-[13px] font-medium text-ink bg-transparent border-none border-b-2 border-b-ink px-5 py-3 cursor-pointer transition-all whitespace-nowrap active"
				data-tab="text"
			>
				API利用
			</button>
			<button
				class="ai-tab-btn text-[13px] font-medium text-muted bg-transparent border-none border-b-2 border-b-transparent px-5 py-3 cursor-pointer transition-all whitespace-nowrap hover:text-ink"
				data-tab="sub"
			>
				サブスク比較
			</button>
		</div>

		{/* ================================================================ */}
		{/* TAB 1: API利用                                                   */}
		{/* ================================================================ */}
		<div class="ai-tab-panel" id="tab-text">
			{/* シナリオボックス */}
			<div class="mt-4 flex items-baseline gap-2 flex-wrap">
				<span class="font-mono text-[9px] tracking-[.1em] text-muted uppercase shrink-0">月額目安 *</span>
				<div>
					<div class="text-[12px] leading-[1.6] text-muted">
						ニュース記事編集（<span class="font-mono text-[12px] text-muted">2,000字</span>査読 + <span class="font-mono text-[12px] text-muted">300字</span>要約）&times; <span class="font-mono text-[12px] text-muted">100回</span> &times; <span class="font-mono text-[12px] text-muted">30日</span>
					</div>
					<div class="font-mono text-[10px] text-muted">
						* input 1,200tok + output 200tok &times; 3,000 req/mo
					</div>
				</div>
			</div>

			{/* PC テーブル */}
			<div class="hidden md:block bg-surface border border-border rounded-sm shadow-[2px_2px_0_rgba(0,0,0,.06)] overflow-x-auto mt-4">
				<table class="w-full border-collapse">
					<thead>
						<tr>
							<th class="font-mono text-[9px] text-muted tracking-[.1em] uppercase text-left py-3.5 px-3.5 border-b border-border bg-surface whitespace-nowrap" style="width:24%">Model</th>
							<th class="font-mono text-[9px] text-muted tracking-[.1em] uppercase text-left py-3.5 px-3.5 border-b border-border bg-surface whitespace-nowrap cursor-pointer" style="width:12%" data-sort="provider">Provider</th>
							<th class="font-mono text-[9px] text-muted tracking-[.1em] uppercase text-left py-3.5 px-3.5 border-b border-border bg-surface whitespace-nowrap cursor-pointer" style="width:16%" data-sort="score">Intelligence</th>
							<th class="font-mono text-[9px] text-muted tracking-[.1em] uppercase text-right py-3.5 px-3.5 border-b border-border bg-surface whitespace-nowrap" style="width:18%">$/1M tok (in/out)</th>
							<th class="font-mono text-[9px] text-muted tracking-[.1em] uppercase text-right py-3.5 px-3.5 border-b border-border bg-surface whitespace-nowrap cursor-pointer" style="width:14%" data-sort="monthly">月額目安 *</th>
						</tr>
					</thead>
					<tbody id="api-tbody">
						{models.map((m, i) => {
							const score = m.score ?? 0;
							const tier = getTier(score);
							const monthly = estimateMonthly(m.inputPrice, m.outputPrice, m.currency);
							const dotClass = providerDotClass[m.provider] ?? "";
							return (
								<tr
									class:list={[
										"hover:bg-[rgba(0,0,0,.015)] transition-colors",
										i >= 10 ? "api-hidden" : ""
									]}
									data-score={score.toFixed(1)}
									data-provider={m.provider}
									data-monthly={monthly.replace(/[^0-9]/g, "")}
								>
									<td class="text-[13px] font-bold text-ink tracking-[-0.01em] py-2.5 px-3.5 border-b border-border align-middle">{m.modelName}</td>
									<td class="py-2.5 px-3.5 border-b border-border align-middle">
										<span class="flex items-center gap-1.5">
											<span class:list={["provider-dot", dotClass]}></span>
											<span class="font-mono text-[10px] text-muted tracking-[.04em]">{m.provider}</span>
										</span>
									</td>
									<td class="py-2.5 px-3.5 border-b border-border align-middle">
										<div class="flex items-center gap-1.5">
											<div class:list={["bench-bar", tier]} style={`width:${Math.round(score)}px`}></div>
											<span class="font-mono text-[10px] text-muted min-w-5 text-right">{score.toFixed(1)}</span>
										</div>
									</td>
									<td class="font-mono text-[12px] text-ink text-right py-2.5 px-3.5 border-b border-border align-middle whitespace-nowrap tracking-[.02em]">
										${m.inputPrice.toFixed(2)} / ${m.outputPrice.toFixed(2)}
									</td>
									<td class="font-mono text-[12px] text-right py-2.5 px-3.5 border-b border-border align-middle whitespace-nowrap tracking-[.02em]">
										{monthly}
									</td>
								</tr>
							);
						})}
					</tbody>
				</table>
			</div>

			{/* SP ソートバー */}
			<div class="hidden max-md:flex items-center gap-1.5 py-2 mt-2">
				<span class="text-[11px] text-muted">並び替え:</span>
				<button class="sp-sort-btn text-[11px] bg-surface border border-ink rounded px-2 py-0.5 cursor-pointer text-ink active" data-sort="score">ELO</button>
				<button class="sp-sort-btn text-[11px] bg-surface border border-border rounded px-2 py-0.5 cursor-pointer text-muted" data-sort="provider">Provider</button>
				<button class="sp-sort-btn text-[11px] bg-surface border border-border rounded px-2 py-0.5 cursor-pointer text-muted" data-sort="monthly">月額</button>
			</div>

			{/* SP カード */}
			<div class="md:hidden" id="api-sp">
				{models.map((m, i) => {
					const score = m.score ?? 0;
					const tier = getTier(score);
					const monthly = estimateMonthly(m.inputPrice, m.outputPrice, m.currency);
					const dotClass = providerDotClass[m.provider] ?? "";
					return (
						<div
							class:list={[
								"sp-card bg-surface border-b border-border py-2 px-3 flex items-center gap-2.5",
								i === 0 ? "border-t border-t-border" : "",
								i >= 10 ? "api-hidden-sp" : ""
							]}
							data-score={score.toFixed(1)}
							data-provider={m.provider}
							data-monthly={monthly.replace(/[^0-9]/g, "")}
						>
							<div class="flex flex-col flex-1 min-w-0 gap-0.5">
								<div class="overflow-hidden text-ellipsis whitespace-nowrap">
									<span class="font-bold text-[12px]">{m.modelName}</span>
									<span class="font-mono text-[9px] text-muted ml-1">
										<span class:list={["provider-dot", dotClass]}></span>{m.provider}
									</span>
								</div>
								<div class="flex items-center gap-1">
									<span class="font-mono text-[9px] text-ink">{score.toFixed(1)}</span>
									<div class:list={["bench-bar h-[3px]", tier]} style={`width:${Math.round(score)}px`}></div>
								</div>
							</div>
							<div class="ml-auto shrink-0">
								<span class="font-mono text-[11px] whitespace-nowrap">{monthly}</span>
							</div>
						</div>
					);
				})}
			</div>

			{models.length > 10 && (
				<button
					class="block w-full py-3 mt-2 bg-transparent border border-dashed border-border rounded-sm font-mono text-[11px] text-muted tracking-[.06em] cursor-pointer transition-all hover:border-ink hover:text-ink"
					id="api-more"
				>
					+ もっと見る
				</button>
			)}
		</div>

		{/* ================================================================ */}
		{/* TAB 2: サブスク比較                                              */}
		{/* ================================================================ */}
		<div class="ai-tab-panel hidden" id="tab-sub">
			<div class="mt-5 mb-4.5">
				<h2 class="text-[17px] font-bold tracking-[-0.01em]">サブスクリプション比較</h2>
				<div class="h-px bg-border my-2"></div>
				<span class="font-mono text-[10px] text-muted tracking-[.06em]">sorted by provider</span>
			</div>

			{/* PC テーブル */}
			<div class="hidden md:block bg-surface border border-border rounded-sm shadow-[2px_2px_0_rgba(0,0,0,.06)] overflow-x-auto">
				<table class="w-full border-collapse">
					<thead>
						<tr>
							<th class="font-mono text-[9px] text-muted tracking-[.1em] uppercase text-left py-3.5 px-3.5 border-b border-border bg-surface whitespace-nowrap cursor-pointer" style="width:12%" data-sort="provider">Provider</th>
							<th class="font-mono text-[9px] text-muted tracking-[.1em] uppercase text-left py-3.5 px-3.5 border-b border-border bg-surface whitespace-nowrap" style="width:12%">Service</th>
							<th class="font-mono text-[9px] text-muted tracking-[.1em] uppercase text-left py-3.5 px-3.5 border-b border-border bg-surface whitespace-nowrap" style="width:10%">Plan</th>
							<th class="font-mono text-[9px] text-muted tracking-[.1em] uppercase text-right py-3.5 px-3.5 border-b border-border bg-surface whitespace-nowrap cursor-pointer" style="width:9%" data-sort="price">月額</th>
							<th class="font-mono text-[9px] text-muted tracking-[.1em] uppercase text-left py-3.5 px-3.5 border-b border-border bg-surface whitespace-nowrap" style="width:30%">モデル / 機能</th>
							<th class="font-mono text-[9px] text-muted tracking-[.1em] uppercase text-left py-3.5 px-3.5 border-b border-border bg-surface whitespace-nowrap" style="width:27%">制限・備考</th>
						</tr>
					</thead>
					<tbody id="sub-tbody">
						{plans.map((p) => {
							const modelList = parseModels(p.models);
							const priceStr = p.price === 0
								? "¥0"
								: p.currency === "JPY"
									? `¥${p.price.toLocaleString()}`
									: `$${p.price}`;
							const dotClass = providerDotClass[p.provider] ?? "";
							return (
								<tr class="hover:bg-[rgba(0,0,0,.015)] transition-colors" data-provider={p.provider} data-price={p.price}>
									<td class="py-2.5 px-3.5 border-b border-border align-middle">
										<span class="flex items-center gap-1.5">
											<span class:list={["provider-dot", dotClass]}></span>
											<span class="font-mono text-[10px] text-muted tracking-[.04em]">{p.provider}</span>
										</span>
									</td>
									<td class="py-2.5 px-3.5 border-b border-border align-middle text-[13px] font-bold text-ink">{p.service}</td>
									<td class="py-2.5 px-3.5 border-b border-border align-middle">
										<span class="font-mono text-[10px] tracking-[.04em] px-1.5 py-0.5 rounded-sm text-muted border border-border">
											{p.planName}
										</span>
									</td>
									<td class="font-mono text-[12px] text-right py-2.5 px-3.5 border-b border-border align-middle whitespace-nowrap">{priceStr}</td>
									<td class="py-2.5 px-3.5 border-b border-border align-middle">
										<div class="flex gap-1 flex-wrap">
											{modelList.map((model) => (
												<span class="font-mono text-[9px] text-ink bg-bg border border-border px-1.5 py-0.5 rounded-sm whitespace-nowrap">
													{model}
												</span>
											))}
										</div>
									</td>
									<td class="py-2.5 px-3.5 border-b border-border align-middle text-[11px] text-muted leading-[1.5]">{p.limits ?? "—"}</td>
								</tr>
							);
						})}
					</tbody>
				</table>
			</div>

			{/* SP ソートバー */}
			<div class="hidden max-md:flex items-center gap-1.5 py-2 mt-2">
				<span class="text-[11px] text-muted">並び替え:</span>
				<button class="sub-sp-sort-btn text-[11px] bg-surface border border-ink rounded px-2 py-0.5 cursor-pointer text-ink active" data-sort="provider">Provider</button>
				<button class="sub-sp-sort-btn text-[11px] bg-surface border border-border rounded px-2 py-0.5 cursor-pointer text-muted" data-sort="price">月額</button>
			</div>
			{/* SP カード */}
			<div class="md:hidden" id="sub-sp">
				{plans.map((p, i) => {
					const modelList = parseModels(p.models);
					const priceStr = p.price === 0
						? "¥0"
						: p.currency === "JPY"
							? `¥${p.price.toLocaleString()}`
							: `$${p.price}`;
					const dotClass = providerDotClass[p.provider] ?? "";
					return (
						<div class:list={[
							"sub-sp-card bg-surface border-b border-border py-2 px-3 flex flex-col gap-1",
							i === 0 ? "border-t border-t-border" : ""
						]} data-provider={p.provider} data-price={p.price}>
							<div class="flex items-center gap-2">
								<div class="flex-1 min-w-0 overflow-hidden text-ellipsis whitespace-nowrap">
									<span class="font-bold text-[12px]">{p.service}</span>
									<span class="font-mono text-[10px] tracking-[.04em] px-1.5 py-0.5 rounded-sm text-muted border border-border ml-1.5">
										{p.planName}
									</span>
									<br />
									<span class="font-mono text-[9px] text-muted">
										<span class:list={["provider-dot", dotClass]}></span>{p.provider}
									</span>
								</div>
								<span class="font-mono text-[11px] whitespace-nowrap shrink-0">{priceStr}</span>
							</div>
							<div class="flex gap-1 flex-wrap">
								{modelList.map((model) => (
									<span class="font-mono text-[9px] text-ink bg-bg border border-border px-1.5 py-0.5 rounded-sm whitespace-nowrap">
										{model}
									</span>
								))}
							</div>
							{p.limits && <div class="text-[11px] text-muted leading-[1.5]">{p.limits}</div>}
						</div>
					);
				})}
			</div>
		</div>

		{/* 付箋 */}
		{commentText && (
			<div class="mt-7 flex justify-center">
				<div class="relative w-full max-w-[600px] p-5 pb-6.5 bg-sticky-4 shadow-[3px_5px_12px_rgba(0,0,0,.18),0_1px_3px_rgba(0,0,0,.08)] rotate-[-0.5deg] max-md:rotate-0 max-md:max-w-full">
					<div class="font-mono text-[10px] tracking-[.08em] text-sticky-ink opacity-50 mb-2">
						GAL SUMMARY
					</div>
					<div class="text-[12.5px] leading-[1.9] text-sticky-ink">
						{commentText}
					</div>
					<div class="sticky-fold max-md:hidden"></div>
				</div>
			</div>
		)}
	</main>
</Layout>

<style>
	.ai-tab-panel.hidden {
		display: none;
	}
	.api-hidden {
		display: none;
	}
	.show-all-api .api-hidden {
		display: table-row;
	}
	.api-hidden-sp {
		display: none;
	}
	.show-all-api-sp .api-hidden-sp {
		display: flex;
	}

	/* プロバイダードット（20色） */
	.provider-dot {
		display: inline-block;
		width: 6px;
		height: 6px;
		border-radius: 50%;
		margin-right: 5px;
		vertical-align: middle;
	}
	.dot-openai { background: #10a37f; }
	.dot-anthropic { background: #d97706; }
	.dot-google { background: #4285f4; }
	.dot-deepseek { background: #6366f1; }
	.dot-xai { background: #1a1a1a; }
	.dot-meta { background: #0668E1; }
	.dot-mistral { background: #ff7000; }
	.dot-bfl { background: #e44d26; }
	.dot-midjourney { background: #5865F2; }
	.dot-ideogram { background: #ff6b35; }
	.dot-stability { background: #a855f7; }
	.dot-perplexity { background: #20808d; }
	.dot-recraft { background: #ef4444; }
	.dot-alibaba { background: #ff6a00; }
	.dot-moonshot { background: #6c5ce7; }
	.dot-minimax { background: #00b894; }
	.dot-zhipu { background: #3b82f6; }
	.dot-xiaomi { background: #ff6900; }
	.dot-amazon { background: #ff9900; }
	.dot-microsoft { background: #00a4ef; }

	/* ベンチマークバー */
	.bench-bar {
		height: 6px;
		border-radius: 1px;
		min-width: 2px;
		background: var(--color-border);
	}
	.bench-bar.tier-s,
	.bench-bar.tier-a,
	.bench-bar.tier-b,
	.bench-bar.tier-c {
		background: var(--color-accent);
	}

	/* ソート可能ヘッダー */
	th[data-sort] {
		cursor: pointer;
		user-select: none;
	}
	th[data-sort]:hover {
		color: var(--color-ink);
	}
	th[data-sort]::after {
		content: ' ↕';
		font-size: 8px;
		opacity: .4;
	}
	th[data-sort].sort-asc::after {
		content: ' ↑';
		opacity: .7;
	}
	th[data-sort].sort-desc::after {
		content: ' ↓';
		opacity: .7;
	}

	/* プロバイダー間ギャップ */
	tr.provider-gap td {
		border-top: 2px solid var(--color-border);
		padding-top: 14px;
	}
	.sp-card.provider-gap,
	.sub-sp-card.provider-gap {
		margin-top: 12px;
		border-top: 2px solid var(--color-border);
		padding-top: 12px;
	}

	.sticky-fold {
		position: absolute;
		bottom: 0;
		right: 0;
		width: 0;
		height: 0;
		border-style: solid;
		border-width: 0 0 22px 22px;
		border-color: transparent transparent rgba(0, 0, 0, 0.18) transparent;
	}
</style>

<script>
	// タブ切り替え
	document.querySelectorAll(".ai-tab-btn").forEach((btn) => {
		btn.addEventListener("click", () => {
			document.querySelectorAll(".ai-tab-btn").forEach((b) => {
				b.classList.remove("active", "text-ink", "border-b-ink");
				b.classList.add("text-muted", "border-b-transparent");
			});
			btn.classList.add("active", "text-ink", "border-b-ink");
			btn.classList.remove("text-muted", "border-b-transparent");

			document.querySelectorAll(".ai-tab-panel").forEach((p) => p.classList.add("hidden"));
			const tabId = (btn as HTMLElement).dataset.tab;
			document.getElementById("tab-" + tabId)?.classList.remove("hidden");
		});
	});

	// もっと見る
	const apiMore = document.getElementById("api-more");
	let apiExpanded = false;
	apiMore?.addEventListener("click", () => {
		apiExpanded = !apiExpanded;
		const panel = document.getElementById("tab-text");
		const sp = document.getElementById("api-sp");
		if (apiExpanded) {
			panel?.classList.add("show-all-api");
			sp?.classList.add("show-all-api-sp");
			apiMore.textContent = "- 閉じる";
		} else {
			panel?.classList.remove("show-all-api");
			sp?.classList.remove("show-all-api-sp");
			apiMore.textContent = "+ もっと見る";
		}
	});

	// ソート状態
	let apiSort = { key: "score", dir: "desc" };

	// 共通ソート関数（PC + SP 両方）
	function sortApiRows(key: string, dir: string) {
		const tbody = document.getElementById("api-tbody");
		const sp = document.getElementById("api-sp");
		if (!tbody || !sp) return;

		const rows = Array.from(tbody.querySelectorAll("tr")) as HTMLElement[];
		const cards = Array.from(sp.querySelectorAll(".sp-card")) as HTMLElement[];

		const compare = (a: HTMLElement, b: HTMLElement) => {
			if (key === "provider") {
				const pa = a.dataset.provider ?? "";
				const pb = b.dataset.provider ?? "";
				const c = pa.localeCompare(pb);
				if (c !== 0) return dir === "asc" ? c : -c;
				// 同プロバイダー内はスコア降順
				return parseFloat(b.dataset.score ?? "0") - parseFloat(a.dataset.score ?? "0");
			} else if (key === "score") {
				const va = parseFloat(a.dataset.score ?? "0");
				const vb = parseFloat(b.dataset.score ?? "0");
				return dir === "asc" ? va - vb : vb - va;
			} else {
				const va = parseInt(a.dataset.monthly ?? "0");
				const vb = parseInt(b.dataset.monthly ?? "0");
				return dir === "asc" ? va - vb : vb - va;
			}
		};

		rows.sort(compare);
		cards.sort(compare);

		// PC: 並べ替え + hidden-row 再設定 + provider-gap
		rows.forEach((r, i) => {
			r.classList.toggle("api-hidden", i >= 10);
			r.classList.remove("provider-gap");
			tbody.appendChild(r);
		});
		cards.forEach((c, i) => {
			c.classList.toggle("api-hidden-sp", i >= 10);
			c.classList.remove("provider-gap");
			sp.appendChild(c);
		});

		// プロバイダーソート時にギャップ追加
		if (key === "provider") {
			for (let i = 1; i < rows.length; i++) {
				if (rows[i].dataset.provider !== rows[i - 1].dataset.provider) {
					rows[i].classList.add("provider-gap");
				}
			}
			for (let i = 1; i < cards.length; i++) {
				if (cards[i].dataset.provider !== cards[i - 1].dataset.provider) {
					cards[i].classList.add("provider-gap");
				}
			}
		}

		// もっと見るをリセット
		const panel = document.getElementById("tab-text");
		panel?.classList.remove("show-all-api");
		sp?.classList.remove("show-all-api-sp");
		if (apiMore) apiMore.textContent = "+ もっと見る";
		apiExpanded = false;
	}

	// PC: ソート可能ヘッダークリック
	document.querySelectorAll("#tab-text th[data-sort]").forEach((th) => {
		th.addEventListener("click", () => {
			const key = (th as HTMLElement).dataset.sort!;
			let dir: string;
			if (apiSort.key === key) {
				dir = apiSort.dir === "desc" ? "asc" : "desc";
			} else {
				dir = key === "provider" ? "asc" : "desc";
			}
			apiSort = { key, dir };

			// ヘッダー表示更新
			document.querySelectorAll("#tab-text th[data-sort]").forEach((h) => {
				h.classList.remove("sort-asc", "sort-desc");
			});
			th.classList.add("sort-" + dir);

			// SP ソートボタンも同期
			document.querySelectorAll(".sp-sort-btn").forEach((b) => {
				b.classList.remove("active", "text-ink", "border-ink");
				b.classList.add("text-muted", "border-border");
				if ((b as HTMLElement).dataset.sort === key) {
					b.classList.add("active", "text-ink", "border-ink");
					b.classList.remove("text-muted", "border-border");
				}
			});

			sortApiRows(key, dir);
		});
	});

	// SP: ソートバークリック
	document.querySelectorAll(".sp-sort-btn").forEach((btn) => {
		btn.addEventListener("click", () => {
			const key = (btn as HTMLElement).dataset.sort!;
			let dir: string;
			if (apiSort.key === key) {
				dir = apiSort.dir === "desc" ? "asc" : "desc";
			} else {
				dir = key === "provider" ? "asc" : "desc";
			}
			apiSort = { key, dir };

			// SP ボタン表示更新
			document.querySelectorAll(".sp-sort-btn").forEach((b) => {
				b.classList.remove("active", "text-ink", "border-ink");
				b.classList.add("text-muted", "border-border");
			});
			btn.classList.add("active", "text-ink", "border-ink");
			btn.classList.remove("text-muted", "border-border");

			// PC ヘッダーも同期
			document.querySelectorAll("#tab-text th[data-sort]").forEach((h) => {
				h.classList.remove("sort-asc", "sort-desc");
				if ((h as HTMLElement).dataset.sort === key) {
					h.classList.add("sort-" + dir);
				}
			});

			sortApiRows(key, dir);
		});
	});
</script>

