---
import { env } from "cloudflare:workers";
import { desc, sql } from "drizzle-orm";
import Layout from "../layouts/Layout.astro";
import { getDb } from "../db/client";
import { llmModels, subscriptionPlans, pageComments } from "../db/schema";
import { AiTabs } from "../components/AiTabs";
import { formatDisplayDate } from "../lib/date";

const db = getDb(env.DB);

const models = await db
	.select()
	.from(llmModels)
	.orderBy(desc(llmModels.score));

const plans = await db
	.select()
	.from(subscriptionPlans)
	.orderBy(subscriptionPlans.provider, subscriptionPlans.price);

// AI比較コメント（ページ全体で1つ）
const aiComment = await db
	.select()
	.from(pageComments)
	.where(sql`${pageComments.type} = 'ai_api'`)
	.orderBy(desc(pageComments.createdAt))
	.limit(1);

const commentText = aiComment[0]?.content ?? null;

// プロバイダーのドット色（20色）
const providerDotClass: Record<string, string> = {
	OpenAI: "dot-openai",
	Anthropic: "dot-anthropic",
	Google: "dot-google",
	DeepSeek: "dot-deepseek",
	xAI: "dot-xai",
	Meta: "dot-meta",
	Mistral: "dot-mistral",
	BFL: "dot-bfl",
	Midjourney: "dot-midjourney",
	Ideogram: "dot-ideogram",
	Stability: "dot-stability",
	Perplexity: "dot-perplexity",
	Recraft: "dot-recraft",
	Alibaba: "dot-alibaba",
	Moonshot: "dot-moonshot",
	MiniMax: "dot-minimax",
	"Zhipu AI": "dot-zhipu",
	Xiaomi: "dot-xiaomi",
	Amazon: "dot-amazon",
	Microsoft: "dot-microsoft",
};
---

<Layout title="AI比較" currentPage="ai">
	<div
		class="relative z-1 max-w-265 mx-auto px-10 pt-7 pb-0 flex items-baseline justify-between max-md:px-4 max-md:pt-5"
	>
		<div class="font-mono text-[11px] text-muted tracking-[.06em]">
			{formatDisplayDate(new Date().toISOString().slice(0, 10))}
		</div>
	</div>
	<AiTabs
		client:idle
		models={models}
		plans={plans}
		commentText={commentText}
		providerDotClass={providerDotClass}
	/>
</Layout>

<style is:global>
	@import "../styles/ai.css";
</style>
