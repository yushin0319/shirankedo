---
import { env } from "cloudflare:workers";
import { desc } from "drizzle-orm";
import Layout from "../layouts/Layout.astro";
import NewsCard from "../components/NewsCard.astro";
import { getDb } from "../db/client";
import { articles } from "../db/schema";
import { formatDisplayDate } from "../lib/date";

const db = getDb(env.DB);

const rows = await db
	.select()
	.from(articles)
	.orderBy(desc(articles.impact), desc(articles.publishedAt))
	.limit(20);

const today = new Date().toISOString().slice(0, 10);
const todayCount = rows.filter((r) => r.publishedAt === today).length;
---

<Layout title="ニュース" currentPage="news">
	<div
		class="relative z-1 max-w-[1060px] mx-auto px-10 pt-7 pb-5 flex items-baseline justify-between max-md:px-4 max-md:pt-5 max-md:pb-4"
	>
		<div class="font-mono text-[11px] text-muted tracking-[.06em]">
			{formatDisplayDate(today)}&nbsp;&middot;&nbsp;{todayCount} new stories
		</div>
	</div>
	<main class="relative z-1 max-w-[1060px] mx-auto px-10 pb-20 max-md:px-4 max-md:pb-15">
		<div class="flex flex-col">
			{
				rows.map((article, i) => (
					<NewsCard
						title={article.title}
						summary={article.summary}
						comment={article.comment}
						url={article.url}
						source={article.source}
						tags={JSON.parse(article.tags)}
						publishedAt={article.publishedAt}
						isPaper={article.isPaper === 1}
						index={i}
					/>
				))
			}
		</div>
		{
			rows.length === 0 && (
				<p class="text-center text-muted py-20 font-mono text-sm">
					まだ記事がないよ〜。知らんけど
				</p>
			)
		}
	</main>
</Layout>
