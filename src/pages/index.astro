---
import { env } from "cloudflare:workers";
import Layout from "../layouts/Layout.astro";
import NewsCard from "../components/NewsCard.astro";
import { getDb } from "../db/client";
import { articles } from "../db/schema";
import { formatDisplayDate } from "../lib/date";
import { topArticles } from "../lib/articles";
import { FETCH_LIMIT } from "../lib/constants";
import { queryD1 } from "../lib/d1-wrapper";

let rows: any[] = [];
let fetchError = false;

try {
	const db = getDb(env.DB);
	const allRows = await queryD1("articles.all", () =>
		db.select().from(articles),
	);
	const now = new Date();
	rows = topArticles(allRows, FETCH_LIMIT, now);
} catch (e) {
	console.error("Failed to fetch articles:", e);
	fetchError = true;
}

const today = new Date().toISOString().slice(0, 10);
---

<Layout title="ニュース" currentPage="news">
	<div
		class="relative z-1 max-w-[1060px] mx-auto px-10 pt-7 pb-0 flex items-baseline justify-between max-md:px-4 max-md:pt-5"
	>
		<div class="font-mono text-[11px] text-muted tracking-[.06em]">
			{formatDisplayDate(today)}
		</div>
	</div>
	<main class="relative z-1 max-w-[1060px] mx-auto px-10 pt-6 pb-20 max-md:px-4 max-md:pb-15">
		<button
			class="hidden fixed top-16 right-4 z-50 font-mono text-[10px] tracking-[.06em] text-muted bg-surface/80 backdrop-blur-sm border border-border rounded-sm px-3 py-1.5 cursor-pointer transition-all hover:text-ink hover:border-ink"
			id="filter-reset"
		>
			× フィルタ解除
		</button>
		<div class="flex flex-col" id="news-list">
			{
				rows.map((article, i) => {
					const tagsArr = JSON.parse(article.tags) as string[];
					if (article.isPaper === 1) tagsArr.unshift("PAPER");
					return (
					<div class:list={[{ "news-hidden": i >= 10 }]} data-tags={JSON.stringify(tagsArr)}>
						<NewsCard
							title={article.title}
							summary={article.summary}
							comment={article.comment}
							url={article.url}
							source={article.source}
							tags={JSON.parse(article.tags)}
							publishedAt={article.publishedAt}
							isPaper={article.isPaper === 1}
							index={i}
						/>
					</div>
				);})
			}
		</div>
		{rows.length > 10 && (
			<button
				class="block w-full max-w-[400px] mx-auto mt-6 py-3.5 font-mono text-xs tracking-[.06em] text-muted bg-surface border border-dashed border-border rounded-sm cursor-pointer transition-all hover:text-ink hover:border-ink"
				id="load-more"
			>
				+ もっと見る
			</button>
		)}
		{
			fetchError && (
				<p class="text-center text-muted py-20 font-mono text-sm">
					データの取得に失敗しました。しばらく待ってから再読み込みしてね
				</p>
			)
		}
		{
			!fetchError && rows.length === 0 && (
				<p class="text-center text-muted py-20 font-mono text-sm">
					まだ記事がないよ〜。知らんけど
				</p>
			)
		}
	</main>
</Layout>

<style>
	.news-hidden {
		display: none;
	}
</style>

<script>
	import { PAGE_STEP } from "../lib/constants";
	const STEP = PAGE_STEP;
	const loadMore = document.getElementById("load-more");
	const filterReset = document.getElementById("filter-reset");
	const allCards = document.querySelectorAll<HTMLElement>("#news-list > div");
	const hiddenItems = document.querySelectorAll<HTMLElement>("#news-list .news-hidden");
	let visible = 0;
	let isFiltered = false;

	loadMore?.addEventListener("click", () => {
		const batch = Array.from(hiddenItems).slice(visible, visible + STEP);
		for (const item of batch) {
			item.classList.remove("news-hidden");
		}
		visible += batch.length;
		if (visible >= hiddenItems.length) {
			loadMore.style.display = "none";
		}
	});

	// フィルタ解除: DOM操作で初期状態に戻す（リロードなし）
	filterReset?.addEventListener("click", () => {
		isFiltered = false;
		visible = 0;
		for (const card of allCards) {
			card.style.display = "";
		}
		// 初期表示数(STEP)を超えるカードを再び非表示
		for (const item of hiddenItems) {
			item.classList.add("news-hidden");
		}
		if (loadMore && hiddenItems.length > 0) loadMore.style.display = "";
		filterReset.classList.add("hidden");
	});

	// タグフィルタ: タグをクリックすると該当タグの記事のみ表示
	document.addEventListener("click", (e) => {
		const target = (e.target as HTMLElement).closest<HTMLElement>(".news-tag-filter");
		if (!target) return;

		const tag = target.dataset.tag;
		if (!tag) return;

		isFiltered = true;
		for (const card of allCards) {
			const tags = card.dataset.tags;
			if (!tags) continue;
			const parsed: string[] = JSON.parse(tags);
			if (parsed.includes(tag)) {
				card.style.display = "";
				card.classList.remove("news-hidden");
			} else {
				card.style.display = "none";
			}
		}

		if (loadMore) loadMore.style.display = "none";
		if (filterReset) filterReset.classList.remove("hidden");
	});
</script>
