---
import { env } from "cloudflare:workers";
import Layout from "../layouts/Layout.astro";
import NewsCard from "../components/NewsCard.astro";
import { getDb } from "../db/client";
import { articles } from "../db/schema";
import { formatDisplayDate } from "../lib/date";
import { dedupeByTitle } from "../lib/articles";
import { articleDecayScore } from "../lib/score";

const db = getDb(env.DB);

const allRows = await db.select().from(articles);

const now = new Date();
const rows = dedupeByTitle(allRows).sort(
	(a, b) => articleDecayScore(b.impact, b.publishedAt, now) - articleDecayScore(a.impact, a.publishedAt, now),
);

const today = new Date().toISOString().slice(0, 10);
---

<Layout title="ニュース" currentPage="news">
	<div
		class="relative z-1 max-w-[1060px] mx-auto px-10 pt-7 pb-0 flex items-baseline justify-between max-md:px-4 max-md:pt-5"
	>
		<div class="font-mono text-[11px] text-muted tracking-[.06em]">
			{formatDisplayDate(today)}
		</div>
	</div>
	<main class="relative z-1 max-w-[1060px] mx-auto px-10 pt-6 pb-20 max-md:px-4 max-md:pb-15">
		<div class="flex flex-col" id="news-list">
			{
				rows.map((article, i) => (
					<div class:list={[{ "news-hidden": i >= 10 }]}>
						<NewsCard
							title={article.title}
							summary={article.summary}
							comment={article.comment}
							url={article.url}
							source={article.source}
							tags={JSON.parse(article.tags)}
							publishedAt={article.publishedAt}
							isPaper={article.isPaper === 1}
							index={i}
						/>
					</div>
				))
			}
		</div>
		{rows.length > 10 && (
			<button
				class="block w-full max-w-[400px] mx-auto mt-6 py-3.5 font-mono text-xs tracking-[.06em] text-muted bg-surface border border-dashed border-border rounded-sm cursor-pointer transition-all hover:text-ink hover:border-ink"
				id="load-more"
			>
				+ もっと見る
			</button>
		)}
		{
			rows.length === 0 && (
				<p class="text-center text-muted py-20 font-mono text-sm">
					まだ記事がないよ〜。知らんけど
				</p>
			)
		}
	</main>
</Layout>

<style>
	.news-hidden {
		display: none;
	}
</style>

<script>
	const STEP = 10;
	const loadMore = document.getElementById("load-more");
	const hiddenItems = document.querySelectorAll<HTMLElement>("#news-list .news-hidden");
	let visible = 0;

	loadMore?.addEventListener("click", () => {
		const batch = Array.from(hiddenItems).slice(visible, visible + STEP);
		for (const item of batch) {
			item.classList.remove("news-hidden");
		}
		visible += batch.length;
		if (visible >= hiddenItems.length) {
			loadMore.style.display = "none";
		}
	});
</script>
