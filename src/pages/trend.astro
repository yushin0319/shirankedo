---
import { env } from "cloudflare:workers";
import { desc, sql } from "drizzle-orm";
import Layout from "../layouts/Layout.astro";
import { getDb } from "../db/client";
import { trackingRepos, repoStats, pageComments } from "../db/schema";
import { isNewRepo } from "../lib/trend";
import { formatDisplayDate } from "../lib/date";
import { repoToGitHubUrl } from "../lib/github";
import { TREND_LOOKBACK_DAYS } from "../lib/constants";

let ranked: any[] = [];
let trendComment: string | null = null;
let fetchError = false;
const now = new Date();

try {
	const db = getDb(env.DB);

	const repos = await db.select().from(trackingRepos);

	const lookback = new Date();
	lookback.setDate(lookback.getDate() - TREND_LOOKBACK_DAYS);
	const cutoff = lookback.toISOString().slice(0, 10);

	const latestStats = await db
		.select()
		.from(repoStats)
		.where(sql`${repoStats.createdAt} >= ${cutoff}`)
		.orderBy(desc(repoStats.createdAt));

	const repoMap = new Map<string, { stars: number; prevStars: number; diff: number }>();
	for (const stat of latestStats) {
		const existing = repoMap.get(stat.repo);
		if (!existing) {
			repoMap.set(stat.repo, { stars: stat.stars, prevStars: 0, diff: 0 });
		} else if (existing.prevStars === 0) {
			existing.prevStars = stat.stars;
			existing.diff = existing.stars - stat.stars;
		}
	}

	ranked = repos
		.map((r) => {
			const stats = repoMap.get(r.repo);
			return {
				...r,
				stars: stats?.stars ?? 0,
				diff: stats?.diff ?? 0,
				isNew: isNewRepo(r.publishedAt, now),
			};
		})
		.sort((a, b) => b.diff - a.diff);

	const comment = await db
		.select()
		.from(pageComments)
		.where(sql`${pageComments.type} = 'trend'`)
		.orderBy(desc(pageComments.createdAt))
		.limit(1);

	trendComment = comment[0]?.content ?? null;
} catch (e) {
	console.error("Failed to fetch trend data:", e);
	fetchError = true;
}

---

<Layout title="トレンド" currentPage="trend">
	<div
		class="relative z-1 max-w-[1060px] mx-auto px-10 pt-7 pb-0 flex items-baseline justify-between max-md:px-4 max-md:pt-5"
	>
		<div class="font-mono text-[11px] text-muted tracking-[.06em]">
			{formatDisplayDate(now.toISOString().slice(0, 10))}
		</div>
	</div>
	<main class="relative z-1 max-w-[1060px] mx-auto px-10 pb-20 max-md:px-4 max-md:pb-15">
		{/* section-heading */}
		<div class="flex items-center gap-2.5 mt-7 mb-4">
			<h2 class="font-mono text-xs font-medium tracking-[.08em] text-ink whitespace-nowrap">
				Star急上昇リポジトリ
			</h2>
			<div class="flex-1 h-px bg-border"></div>
			<span class="font-mono text-[10px] text-muted tracking-[.06em] whitespace-nowrap">
				{ranked.length} repos by weekly delta
			</span>
		</div>

		{/* PC: テーブル */}
		<div class="hidden md:block bg-surface border border-border rounded-sm shadow-[2px_2px_0_rgba(0,0,0,.06)] overflow-hidden">
			<table class="w-full border-collapse" aria-label="トレンドリポジトリ">
				<thead>
					<tr>
						<th class="font-mono text-[9px] text-muted tracking-[.1em] uppercase text-left py-3 px-4 pl-6 border-b border-border bg-surface whitespace-nowrap">#</th>
						<th class="font-mono text-[9px] text-muted tracking-[.1em] uppercase text-left py-3 px-4 border-b border-border bg-surface whitespace-nowrap">Repo</th>
						<th class="font-mono text-[9px] text-muted tracking-[.1em] uppercase text-left py-3 px-4 border-b border-border bg-surface whitespace-nowrap">Stars</th>
						<th class="font-mono text-[9px] text-muted tracking-[.1em] uppercase text-left py-3 px-4 border-b border-border bg-surface whitespace-nowrap">Weekly +</th>
						<th class="font-mono text-[9px] text-muted tracking-[.1em] uppercase text-left py-3 px-4 pr-6 border-b border-border bg-surface whitespace-nowrap">Language</th>
					</tr>
				</thead>
				<tbody id="trend-tbody">
					{ranked.map((r, i) => {
						const isNew = r.isNew;
						return (
							<tr class:list={[
								"border-b border-border last:border-b-0 hover:bg-[rgba(0,0,0,.015)] transition-colors",
								i >= 10 ? "trend-hidden" : ""
							]}>
								<td class="font-mono text-[10px] text-muted py-3.5 px-4 pl-6 align-middle w-7">
									{String(i + 1).padStart(2, "0")}
								</td>
								<td class="py-3.5 px-4 align-middle">
									<span class="text-[13px] font-bold text-ink">{r.displayName}</span>
									<a
										href={repoToGitHubUrl(r.repo)}
										target="_blank"
										rel="noopener noreferrer"
										class="inline-flex items-center ml-1.5 text-muted hover:text-ink transition-colors align-middle"
										title={r.repo}
									>
										<svg class="w-3.5 h-3.5" viewBox="0 0 16 16" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
									</a>
									{isNew && (
										<span class="font-mono text-[8px] tracking-[.08em] px-1.5 py-0.5 rounded-sm bg-accent text-white font-medium ml-2 align-middle">NEW</span>
									)}
									{r.description && (
										<span class="text-[11px] text-muted ml-2">{r.description}</span>
									)}
								</td>
								<td class="font-mono text-[12px] text-ink py-3.5 px-4 align-middle">
									{r.stars.toLocaleString()}
								</td>
								<td class="font-mono text-[12px] font-medium py-3.5 px-4 align-middle">
									<span class:list={[r.diff > 0 ? "text-green-600" : "text-muted"]}>
										{r.diff > 0 ? `+${r.diff.toLocaleString()}` : r.diff.toLocaleString()}
									</span>
								</td>
								<td class="font-mono text-[11px] text-muted py-3.5 px-4 pr-6 align-middle">
									{r.language ?? ""}
								</td>
							</tr>
						);
					})}
				</tbody>
			</table>
		</div>
		{ranked.length > 10 && (
			<button
				class="block w-full py-3 mt-2 bg-transparent border border-dashed border-border rounded-sm font-mono text-[11px] text-muted tracking-[.06em] cursor-pointer transition-all hover:border-ink hover:text-ink max-md:hidden"
				id="trend-more"
			>
				+ もっと見る
			</button>
		)}

		{/* SP: カード */}
		<div class="md:hidden flex flex-col gap-3" id="trend-cards">
			{ranked.map((r, i) => {
				const isNew = r.isNew;
				return (
					<div class:list={[
						"bg-surface border border-border rounded-sm shadow-[2px_2px_0_rgba(0,0,0,.06)] p-4",
						i >= 10 ? "trend-hidden-sp" : ""
					]}>
						<div class="flex items-center justify-between mb-2">
							<span class="font-mono text-[10px] text-muted">#{String(i + 1).padStart(2, "0")}</span>
							<span class="font-mono text-[13px] font-medium text-green-600">
								{r.diff > 0 ? `+${r.diff.toLocaleString()}` : r.diff.toLocaleString()}
							</span>
						</div>
						<div class="text-[14px] font-bold text-ink mb-1 flex items-center flex-wrap gap-1">
							{r.displayName}
							<a
								href={repoToGitHubUrl(r.repo)}
								target="_blank"
								rel="noopener noreferrer"
								class="inline-flex items-center text-muted hover:text-ink transition-colors"
								title={r.repo}
							>
								<svg class="w-3.5 h-3.5" viewBox="0 0 16 16" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
							</a>
							{isNew && (
								<span class="font-mono text-[8px] tracking-[.08em] px-1.5 py-0.5 rounded-sm bg-accent text-white font-medium ml-1">NEW</span>
							)}
						</div>
						{r.description && <div class="text-[11.5px] text-muted leading-[1.6] mb-2.5">{r.description}</div>}
						<div class="flex items-center gap-3">
							<span class="font-mono text-[10px] text-muted tracking-[.04em]">{r.stars.toLocaleString()} stars</span>
							{r.language && (
								<span class="font-mono text-[10px] text-muted tracking-[.04em]">{r.language}</span>
							)}
						</div>
					</div>
				);
			})}
		</div>
		{ranked.length > 10 && (
			<button
				class="hidden max-md:block w-full py-3 mt-2 bg-transparent border border-dashed border-border rounded-sm font-mono text-[11px] text-muted tracking-[.06em] cursor-pointer transition-all hover:border-ink hover:text-ink"
				id="trend-more-sp"
			>
				+ もっと見る
			</button>
		)}

		{/* 週間トレンドまとめ */}
		{trendComment && (
			<div class="mt-9 flex justify-center">
				<div class="relative w-full max-w-[600px] p-6 pb-7.5 bg-sticky-1 shadow-[3px_5px_12px_rgba(0,0,0,.18),0_1px_3px_rgba(0,0,0,.08)] rotate-[-0.6deg] max-md:rotate-0 max-md:max-w-full">
					<div class="font-mono text-[10px] tracking-[.08em] text-sticky-ink opacity-50 mb-2">
						WEEKLY TREND SUMMARY
					</div>
					<div class="text-[13px] leading-[1.9] text-sticky-ink">
						{trendComment}
					</div>
					<div class="sticky-fold max-md:hidden"></div>
				</div>
			</div>
		)}

		{fetchError && (
			<p class="text-center text-muted py-20 font-mono text-sm">
				データの取得に失敗しました。しばらく待ってから再読み込みしてね
			</p>
		)}
		{!fetchError && ranked.length === 0 && (
			<p class="text-center text-muted py-20 font-mono text-sm">トレンドデータなし</p>
		)}
	</main>
</Layout>

<style>
	.trend-hidden {
		display: none;
	}
	.trend-hidden-sp {
		display: none;
	}
	.sticky-fold {
		position: absolute;
		bottom: 0;
		right: 0;
		width: 0;
		height: 0;
		border-style: solid;
		border-width: 0 0 24px 24px;
		border-color: transparent transparent rgba(0, 0, 0, 0.18) transparent;
	}
</style>

<script>
	import { PAGE_STEP } from "../lib/constants";
	const STEP = PAGE_STEP;

	// PC: もっと見る（10件ずつ追加）
	const trendMore = document.getElementById("trend-more");
	const trendRows = document.querySelectorAll<HTMLElement>("#trend-tbody tr.trend-hidden");
	let pcVisible = 0;
	trendMore?.addEventListener("click", () => {
		const batch = Array.from(trendRows).slice(pcVisible, pcVisible + STEP);
		for (const row of batch) row.style.display = "table-row";
		pcVisible += batch.length;
		if (pcVisible >= trendRows.length) trendMore.style.display = "none";
	});

	// SP: もっと見る（10件ずつ追加）
	const trendMoreSp = document.getElementById("trend-more-sp");
	const trendCardItems = document.querySelectorAll<HTMLElement>("#trend-cards .trend-hidden-sp");
	let spVisible = 0;
	trendMoreSp?.addEventListener("click", () => {
		const batch = Array.from(trendCardItems).slice(spVisible, spVisible + STEP);
		for (const card of batch) card.style.display = "block";
		spVisible += batch.length;
		if (spVisible >= trendCardItems.length) trendMoreSp.style.display = "none";
	});
</script>
