---
import { env } from "cloudflare:workers";
import { desc, sql } from "drizzle-orm";
import Layout from "../layouts/Layout.astro";
import { getDb } from "../db/client";
import { trackingRepos, repoStats, pageComments } from "../db/schema";

const db = getDb(env.DB);

// 最新2週分のスター数を取得してランキング算出
const repos = await db.select().from(trackingRepos);

// 各リポの最新スター数と1週前のスター数を取得
const latestStats = await db
	.select()
	.from(repoStats)
	.orderBy(desc(repoStats.createdAt));

// リポごとに最新と1つ前を取得
const repoMap = new Map<string, { stars: number; prevStars: number; diff: number }>();
for (const stat of latestStats) {
	const existing = repoMap.get(stat.repo);
	if (!existing) {
		repoMap.set(stat.repo, { stars: stat.stars, prevStars: 0, diff: 0 });
	} else if (existing.prevStars === 0) {
		existing.prevStars = stat.stars;
		existing.diff = existing.stars - stat.stars;
	}
}

// ランキング: 週次差分降順
const ranked = repos
	.map((r) => {
		const stats = repoMap.get(r.repo);
		return {
			...r,
			stars: stats?.stars ?? 0,
			diff: stats?.diff ?? 0,
		};
	})
	.sort((a, b) => b.diff - a.diff);

// トレンドコメント
const comment = await db
	.select()
	.from(pageComments)
	.where(sql`${pageComments.type} = 'trend'`)
	.orderBy(desc(pageComments.createdAt))
	.limit(1);

const trendComment = comment[0]?.content ?? null;

function formatStars(n: number): string {
	if (n >= 1000) return `${(n / 1000).toFixed(1)}k`;
	return String(n);
}
---

<Layout title="トレンド" currentPage="trend">
	<div class="relative z-1 max-w-[1060px] mx-auto px-10 pt-7 pb-5 max-md:px-4 max-md:pt-5 max-md:pb-4">
		<h1 class="font-mono text-[11px] text-muted tracking-[.06em] uppercase">GitHub Star Trends</h1>
	</div>
	<main class="relative z-1 max-w-[1060px] mx-auto px-10 pb-20 max-md:px-4 max-md:pb-15">
		{trendComment && (
			<div class="relative max-w-[400px] mb-8 p-4 pb-5.5 bg-sticky-1 rotate-[-0.6deg] shadow-[3px_5px_12px_rgba(0,0,0,.18),0_1px_3px_rgba(0,0,0,.08)]">
				<p class="text-xs leading-[1.8] text-sticky-ink">{trendComment}</p>
				<div class="sticky-fold"></div>
			</div>
		)}

		{/* PC: テーブル */}
		<div class="hidden md:block">
			<table class="w-full border-collapse">
				<thead>
					<tr class="border-b border-border">
						<th class="font-mono text-[9px] text-muted tracking-[.1em] uppercase text-right py-2 pr-4 w-8">#</th>
						<th class="font-mono text-[9px] text-muted tracking-[.1em] uppercase text-left py-2">Repo</th>
						<th class="font-mono text-[9px] text-muted tracking-[.1em] uppercase text-right py-2 pr-4">Stars</th>
						<th class="font-mono text-[9px] text-muted tracking-[.1em] uppercase text-right py-2 pr-4">Weekly</th>
						<th class="font-mono text-[9px] text-muted tracking-[.1em] uppercase text-left py-2 pl-4">Language</th>
					</tr>
				</thead>
				<tbody>
					{ranked.map((r, i) => (
						<tr class="border-b border-border hover:bg-surface/50 transition-colors">
							<td class="font-mono text-[11px] text-muted text-right py-3 pr-4">{String(i + 1).padStart(2, "0")}</td>
							<td class="py-3">
								<div class="text-[14px] font-bold text-ink">{r.displayName}</div>
								{r.description && <div class="text-[11px] text-muted mt-0.5">{r.description}</div>}
							</td>
							<td class="font-mono text-[12px] text-ink text-right py-3 pr-4">{formatStars(r.stars)}</td>
							<td class="font-mono text-[12px] text-right py-3 pr-4">
								<span class:list={[r.diff > 0 ? "text-tag-oss-text" : "text-muted"]}>
									{r.diff > 0 ? `+${formatStars(r.diff)}` : formatStars(r.diff)}
								</span>
							</td>
							<td class="py-3 pl-4">
								{r.language && (
									<span class="font-mono text-[9px] tracking-[.08em] px-2 py-0.5 rounded-sm bg-tag-career-bg text-tag-career-text">
										{r.language}
									</span>
								)}
							</td>
						</tr>
					))}
				</tbody>
			</table>
		</div>

		{/* SP: カード */}
		<div class="md:hidden flex flex-col gap-3">
			{ranked.map((r, i) => (
				<div class="bg-surface border border-border rounded-sm shadow-[2px_2px_0_rgba(0,0,0,.06)] p-4">
					<div class="flex items-start justify-between mb-2">
						<span class="font-mono text-[10px] text-muted">#{String(i + 1).padStart(2, "0")}</span>
						<span class:list={[
							"font-mono text-[11px] font-medium",
							r.diff > 0 ? "text-tag-oss-text" : "text-muted"
						]}>
							{r.diff > 0 ? `+${formatStars(r.diff)}` : formatStars(r.diff)}
						</span>
					</div>
					<div class="text-[14px] font-bold text-ink mb-1">{r.displayName}</div>
					{r.description && <div class="text-[11px] text-muted mb-2">{r.description}</div>}
					<div class="flex items-center gap-3">
						<span class="font-mono text-[11px] text-muted">{formatStars(r.stars)} stars</span>
						{r.language && (
							<span class="font-mono text-[9px] tracking-[.08em] px-2 py-0.5 rounded-sm bg-tag-career-bg text-tag-career-text">
								{r.language}
							</span>
						)}
					</div>
				</div>
			))}
		</div>

		{ranked.length === 0 && (
			<p class="text-center text-muted py-20 font-mono text-sm">トレンドデータなし</p>
		)}
	</main>
</Layout>

<style>
	.sticky-fold {
		position: absolute;
		bottom: 0;
		right: 0;
		width: 0;
		height: 0;
		border-style: solid;
		border-width: 0 0 20px 20px;
		border-color: transparent transparent rgba(0, 0, 0, 0.18) transparent;
	}
</style>
