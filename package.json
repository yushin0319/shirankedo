{
  "name": "shirankedo",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bash scripts/seed-from-remote.sh && astro dev",
    "seed:remote": "bash scripts/seed-from-remote.sh",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "npx @biomejs/biome check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "dev:e2e": "astro dev",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^13.1.4",
    "@astrojs/react": "^5.0.2",
    "@tailwindcss/vite": "^4.2.2",
    "astro": "^6.1.1",
    "drizzle-orm": "^0.45.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^4.2.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.8",
    "@biomejs/biome": "^2.4.9",
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "better-sqlite3": "^12.8.0",
    "drizzle-kit": "^0.31.10",
    "husky": "^9.1.7",
    "jsdom": "^28.1.0",
    "lint-staged": "^16.4.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.2",
    "wrangler": "^4.80.0"
  },
  "overrides": {
    "lodash": ">=4.17.23",
    "undici": ">=7.24.0",
    "esbuild": ">=0.25.0"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx,css,json,astro}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  }
}
